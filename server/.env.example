# ---------------------------------------------------------------------------
# NOOR API — environment template
#
# Copy to `.env` and fill in real values locally. `.env` is git-ignored.
# This file is COMMITTED, so every value here is a placeholder. Never paste a
# real password, token or key into it.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL (Neon). Get the connection string from the Neon console.
# Keep sslmode=require. Use the *pooled* host for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# JWT — generate your own long random secrets, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The access and refresh secrets MUST be different values.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie. The only place the refresh token is ever sent: HttpOnly,
# scoped to /api/v1/auth, and never present in a response body.
REFRESH_COOKIE_NAME=noor_refresh
# Leave blank for host-only cookies in development.
COOKIE_DOMAIN=

# CORS — comma-separated exact origins. Never "*".
CORS_ORIGINS=http://localhost:3000

# Where the browser app lives, used to build the password-reset link that is emailed to a person.
# Optional: falls back to the first CORS origin. Set it explicitly once CORS_ORIGINS lists more than
# one entry, so the address in someone's inbox is not decided by that list's ordering.
APP_WEB_URL=http://localhost:3000

# Rate limiting (requests per TTL window, in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Swagger — served at /api/docs. Disable in production if the docs are not public.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Email / Mailer (Titan Email SMTP)
#
# Primary configuration: smtp.titan.email on port 465 with SSL.
# In Titan, enable third-party app access. If 2FA is active, generate an application password.
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreply@mostak.tech
EMAIL_PASSWORD=replace-with-titan-password
EMAIL_FROM=noreply@mostak.tech
EMAIL_FROM_NAME=NOOR

# ---------------------------------------------------------------------------
# Prayer times (AlAdhan)
#
# Daily prayer times are calculated by AlAdhan and requested by this API, never by the browser: the
# frontend calls NOOR, NOOR calls AlAdhan, and the mosque's own adjustments are applied on the way
# back. All three values below have working defaults, so none of them has to be set.
# ---------------------------------------------------------------------------
ALADHAN_BASE_URL=https://api.aladhan.com/v1
# Give up on AlAdhan after this long rather than holding the request open (1000–30000).
ALADHAN_TIMEOUT_MS=8000
# How long a day's calculated times are reused. 0 disables caching.
PRAYER_CACHE_TTL_SECONDS=86400

