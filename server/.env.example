# ---------------------------------------------------------------------------
# NOOR API — environment template
#
# Copy to `.env` and fill in real values locally. `.env` is git-ignored.
# This file is COMMITTED, so every value here is a placeholder. Never paste a
# real password, token or key into it.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL (Neon). Get the connection string from the Neon console.
# Keep sslmode=require. Use the *pooled* host for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# JWT — generate your own long random secrets, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The access and refresh secrets MUST be different values.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie. The only place the refresh token is ever sent: HttpOnly,
# scoped to /api/v1/auth, and never present in a response body.
REFRESH_COOKIE_NAME=noor_refresh
# Leave blank for host-only cookies in development.
COOKIE_DOMAIN=

# CORS — comma-separated exact origins. Never "*".
CORS_ORIGINS=http://localhost:3000

# Rate limiting (requests per TTL window, in seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Swagger — served at /api/docs. Disable in production if the docs are not public.
SWAGGER_ENABLED=true
