// NOOR Mosque Management System — Prisma schema
//
// Phase 1 defines the tenancy and identity core: the mosque, the person, their session tokens and
// the audit trail. Domain models (members, prayer times, events, finance) arrive in Phase 2.
//
// Two conventions hold throughout:
//
//  * Every tenant-owned row carries `mosqueId`. The system runs one mosque today and is built so a
//    second one needs no schema change, only a scoped query.
//  * Money is `Decimal`, never `Float`. Binary floating point cannot represent 0.10 exactly, and a
//    ledger that drifts by fractions of a taka is not a ledger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
//
// Mirrors `web/src/lib/permissions.ts`, which is the authority for this model. Seven roles, and
// deliberately no `president`: the President is a *position*, and the person who approves is
// whoever holds `workflow.approve`. When the committee changes, someone reassigns a role and a
// position and no code changes.
// ---------------------------------------------------------------------------

enum Role {
  super_admin
  mosque_admin
  secretary
  treasurer
  cashier
  imam
  member
}

/// Committee posts. These grant nothing — a position never affects a permission check. They exist
/// because a position is the label a person recognises themselves by.
enum Position {
  president
  vice_president
  general_secretary
  assistant_secretary
  treasurer
  cashier
  imam
  muazzin
  khatib
  education_coordinator
  event_coordinator
  volunteer_coordinator
  volunteer
  caretaker
  member
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Mosque {
  id   String @id @default(uuid()) @db.Uuid
  /// URL-safe identifier, stable once issued.
  slug String @unique @db.VarChar(64)
  name String @db.VarChar(160)

  // Contact and location, all optional: a mosque is created before its profile is filled in.
  email        String? @db.VarChar(160)
  phone        String? @db.VarChar(32)
  website      String? @db.VarChar(255)
  addressLine  String? @db.VarChar(255)
  city         String? @db.VarChar(120)
  district     String? @db.VarChar(120)
  country      String? @db.VarChar(120)
  postalCode   String? @db.VarChar(24)
  /// Coordinates for prayer-time calculation. Decimal, not Float — a rounded latitude shifts Fajr.
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  /// IANA zone, e.g. "Asia/Dhaka". Prayer schedules are meaningless without it.
  timezone     String   @default("Asia/Dhaka") @db.VarChar(64)
  establishedYear Int?
  description  String? @db.Text
  logoUrl      String? @db.VarChar(500)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  settings  MosqueSettings?
  facilities Facility[]
  /// At most one row of prayer-calculation overrides. Absent means "calculate from the mosque's own
  /// coordinates and settings, unadjusted".
  prayerSettings   PrayerSettings?
  jumuahSchedules  JumuahSchedule[]
  ramadanSchedules RamadanSchedule[]
  donationFunds    DonationFund[]
  campaigns        Campaign[]
  donations        Donation[]
  expenses         Expense[]
  budgets          Budget[]
  salaryRecords    SalaryRecord[]
  users            User[]
  auditLogs        AuditLog[]
  approvalRequests ApprovalRequest[]

  @@index([isActive])
  @@map("mosques")
}

/// Settings live in their own row rather than as columns on `Mosque`: the frontend edits them as
/// five independent panels (general, notifications, prayer, security, appearance), and separating
/// them keeps a settings write from touching the profile a different screen owns.
model MosqueSettings {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @unique @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  // General
  defaultLanguage String @default("en") @db.VarChar(8)
  currency        String @default("BDT") @db.VarChar(8)
  dateFormat      String @default("DD/MM/YYYY") @db.VarChar(24)

  // Notifications
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  pushNotifications  Boolean @default(true)
  prayerReminders    Boolean @default(true)
  eventReminders     Boolean @default(true)

  // Prayer
  calculationMethod String @default("MuslimWorldLeague") @db.VarChar(48)
  asrMethod         String @default("Standard") @db.VarChar(24)
  /// Minutes added to each calculated time before it is published as the jamaat time.
  iqamahOffset      Int    @default(10)

  // Security
  twoFactorRequired  Boolean @default(false)
  sessionTimeoutMins Int     @default(60)
  passwordMinLength  Int     @default(8)

  // Appearance
  theme       String  @default("system") @db.VarChar(16)
  primaryColor String? @db.VarChar(16)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("mosque_settings")
}

model Facility {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(160)
  description String? @db.Text
  isAvailable Boolean @default(true)
  capacity    Int?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([mosqueId, createdAt])
  @@map("facilities")
}

// ---------------------------------------------------------------------------
// The person
// ---------------------------------------------------------------------------

model User {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  fullName String  @db.VarChar(160)
  /// Stored lowercased so uniqueness is case-insensitive in practice.
  email    String  @db.VarChar(160)
  /// E.164. Sign-in accepts either email or phone, so both are addressable and both are unique.
  phone    String? @db.VarChar(32)

  /// Argon2id output. The plaintext is never stored, never logged, and never returned by any
  /// endpoint — no `select` in this codebase includes this column.
  passwordHash String @db.VarChar(255)

  /// SHA-256 of a short-lived password-reset token. The raw token is never persisted.
  passwordResetTokenHash String?   @unique @db.VarChar(64)
  passwordResetExpiresAt DateTime? @db.Timestamptz

  role Role @default(member)

  /// Committee posts. Display only.
  positions Position[] @default([])

  /// Granted on top of the role, and removed after everything else — deny always wins.
  /// Held as permission *strings* against the registry in code rather than as join tables: the
  /// registry is a fixed, reviewed list that ships with the application, not user-editable data,
  /// and two extra tables would buy referential integrity over constants that already cannot vary.
  permissions       String[] @default([])
  deniedPermissions String[] @default([])

  /// An inactive account resolves false for every permission, base ones included.
  isActive Boolean @default(true)

  // Profile
  dateOfBirth DateTime? @db.Date
  gender      String?   @db.VarChar(8)
  city        String?   @db.VarChar(120)
  avatarUrl   String?   @db.VarChar(500)
  newsletter  Boolean   @default(false)

  emailVerifiedAt DateTime? @db.Timestamptz
  lastLoginAt     DateTime? @db.Timestamptz

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  /// Soft delete. A user is never hard-deleted: their name appears on donations they recorded and
  /// on audit rows, and those references have to keep resolving.
  deletedAt DateTime? @db.Timestamptz

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  /// Donations this person gave. Anonymous donations have no `userId` at all, so they are not here.
  donations     Donation[]
  /// Expenses this person entered. The entry keeps their id, which is one of the reasons a user row is
  /// soft-deleted rather than removed.
  expenses      Expense[]
  /// Budgets this person drew up. Same reason: the plan keeps the name of whoever set it.
  budgets       Budget[]
  /// Salary this person is paid. A staff member is an ordinary user with rows here — there is no separate
  /// imam or employee record anywhere in this schema.
  salaryRecords SalaryRecord[]
  /// At most one: volunteering is something a person either does or does not, not a list of
  /// enrolments. Optional because most members never volunteer.
  volunteer     Volunteer?
  /// Reviews asked for and reviews given, kept apart by name because one person is routinely both —
  /// and the rule that they may not be both on the *same* row is enforced in the service.
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalsReviewed  ApprovalRequest[] @relation("ApprovalReviewer")

  // Unique per mosque, not globally: two mosques may each have a member at the same address.
  @@unique([mosqueId, email])
  @@unique([mosqueId, phone])
  @@index([mosqueId, role])
  @@index([mosqueId, isActive])
  @@index([deletedAt])
  @@index([passwordResetExpiresAt])
  @@map("users")
}

/// One row per issued refresh token, so sessions can be revoked individually and rotation can
/// detect reuse.
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, never the token itself. A leaked database must not yield usable sessions.
  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime @db.Timestamptz
  /// Set when the token is used or explicitly revoked. A rotated token presented a second time is a
  /// signal worth acting on, which is only possible if spent tokens are kept rather than deleted.
  revokedAt DateTime? @db.Timestamptz
  /// Which token replaced this one, for tracing a rotation chain.
  replacedById String? @db.Uuid

  // Coarse client detail for a "your sessions" screen. Not identity, and not used for authorisation.
  userAgent String? @db.VarChar(255)
  ipAddress String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Volunteering
//
// A volunteer is a User who has joined the roster, not a kind of account. There is deliberately no
// `volunteer` role and no second person record: the row below hangs off a User and holds only what
// volunteering adds — what they can do, when they are free, and whether they are currently serving.
// So the same person appears in the members directory, possibly on the committee, and here, and
// their name, email and phone are stored once, on `User`.
//
// Nothing here affects a permission check. `Volunteer.status` and `User.role` are independent: the
// treasurer who helps at iftar is `role = treasurer` with an active volunteer row, and taking them
// off the roster must not touch their role.
// ---------------------------------------------------------------------------

/// `on_leave` exists because the roster already distinguishes it: someone travelling for three
/// months is not inactive, and a coordinator who had only two states would delete the row instead.
enum VolunteerStatus {
  active
  inactive
  on_leave
}

model Volunteer {
  id String @id @default(uuid()) @db.Uuid
  /// Unique, so one person cannot be enrolled twice. The constraint is in the database rather than
  /// only in the service, because two concurrent enrolments would both pass a service-level check.
  /// No `mosqueId`: this row is only ever reached through its user, whose `mosqueId` is the single
  /// source of tenancy — the same reason `RefreshToken` carries none.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status VolunteerStatus @default(active)

  /// Free text, because the roster is written by people rather than chosen from a list:
  /// "Event management", "First aid, driving".
  skills String? @db.VarChar(500)
  /// When they are free, in their own words — "Friday", "weekends after Asr".
  availability String? @db.VarChar(255)
  /// The coordinator's notes. Internal: never part of any public projection.
  notes String? @db.Text

  /// When they joined the roster, which is not when the row was written — a volunteer of ten years
  /// may be entered today.
  joinedAt DateTime @default(now()) @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Serves the roster list, which filters on status and reads newest first.
  @@index([status, createdAt])
  @@map("volunteers")
}

// ---------------------------------------------------------------------------
// Prayer, Jumu'ah and Ramadan
//
// Three models with one thing in common: they hold what a *mosque decides*, never what a calculation
// produces. Daily prayer times are computed by AlAdhan from coordinates and are not stored — they are
// the same for every mosque at the same location and would be a cache masquerading as a record.
// What is stored is the part no formula can know: that this mosque calls Fajr five minutes after the
// calculated time, that its khutbah begins at 13:15, that Taraweeh is at 20:30.
//
// Wall-clock times are `VarChar(5)` holding `HH:mm`, not `DateTime`. A jamaat time is a time of day in
// the mosque's own timezone with no date attached: `time without time zone` comes back through Prisma
// as a `Date` on 1970-01-01 that every caller then has to remember not to read the date part of, and
// `timestamptz` would force a fictional date to be chosen before the value could be written at all.
// `Mosque.timezone` says which wall clock is meant, which is the only other fact needed.
// ---------------------------------------------------------------------------

/// Per-mosque overrides for the calculated daily schedule.
///
/// Every field is either nullable or defaults to zero, and that is the design: a row of all defaults
/// behaves exactly as no row at all. The nullable ones fall back to what the mosque already records —
/// `method` and `school` to `MosqueSettings.calculationMethod` / `asrMethod`, the coordinates and
/// timezone to `Mosque` — so nothing here is a second copy of a value stored elsewhere. A null means
/// "whatever the mosque already says"; a value means someone deliberately overrode it.
model PrayerSettings {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @unique @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// AlAdhan calculation method id. Null derives it from `MosqueSettings.calculationMethod`.
  method Int?
  /// Asr school: 0 = Shafi/Standard, 1 = Hanafi. Null derives it from `MosqueSettings.asrMethod`.
  school Int?

  /// Coordinates to calculate from, when they differ from the mosque's own — a mosque whose registered
  /// address is an office, or one that follows a neighbouring city's schedule. Null uses `Mosque`.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  /// IANA zone override. Null uses `Mosque.timezone`.
  timezone  String?  @db.VarChar(64)

  /// Minutes added to each calculated time before it is published. Signed: −3 is as valid as +5.
  /// One column per prayer rather than an array or a JSON blob, so a migration can widen one of them
  /// and a query can order by one of them.
  imsakOffset    Int @default(0)
  fajrOffset     Int @default(0)
  sunriseOffset  Int @default(0)
  dhuhrOffset    Int @default(0)
  asrOffset      Int @default(0)
  sunsetOffset   Int @default(0)
  maghribOffset  Int @default(0)
  ishaOffset     Int @default(0)
  midnightOffset Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("prayer_settings")
}

/// A Jumu'ah jamaat.
///
/// Never calculated. Khutbah and prayer times are a mosque's own decision — they follow the khatib's
/// availability and the local council, not the sun — so AlAdhan has nothing to say about them.
///
/// `date` is nullable, and the distinction it draws is the model's whole point: null is the standing
/// weekly schedule ("Jumu'ah is at 13:15"), a date is that one Friday ("moved to 12:45 for Eid week").
/// Deliberately not unique on `(mosqueId, date)`: a mosque that fills up holds a second jamaat, and a
/// constraint here would make the common case unrepresentable.
model JumuahSchedule {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// The Friday this applies to. Null is the standing weekly schedule.
  date DateTime? @db.Date

  /// `HH:mm` in `Mosque.timezone`. See the section note above on why these are not DateTime.
  khutbahTime String @db.VarChar(5)
  prayerTime  String @db.VarChar(5)

  /// Who delivers the khutbah, as free text: often a visiting khatib who has no account here.
  imam     String? @db.VarChar(160)
  /// Which hall or floor, for a mosque that runs more than one.
  location String? @db.VarChar(160)
  /// Visible to anyone who can read the prayer schedule. Not a place for private remarks.
  notes    String? @db.Text

  /// False retires an entry without deleting it, so last year's arrangement stays on the record.
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Serves the list, which is scoped to one mosque and read by date. `isActive` is left to a filter
  // rather than given an index of its own: a mosque accumulates a few hundred rows here at most, and
  // a second index on the same table costs every write to save nothing measurable on the read.
  @@index([mosqueId, date])
  @@map("jumuah_schedules")
}

/// One day of Ramadan at one mosque.
///
/// `year` is the Hijri year and is stored rather than derived: a Gregorian date does not yield it
/// without a calendar conversion, and "show me Ramadan 1447" is the question this table is asked.
///
/// Suhoor and Iftar are nullable while the fasting bounds are not, because the bounds are the fast
/// itself and the two meals are the mosque's arrangements around it — a mosque that serves no iftar
/// still has an Iftar time, but one that has not decided yet should be able to publish the rest.
model RamadanSchedule {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// Hijri year, e.g. 1447.
  year Int
  /// The Gregorian day this row describes.
  date DateTime @db.Date

  /// `HH:mm` in `Mosque.timezone`. When the fast begins (Imsak) and ends (Maghrib).
  fastingStart String @db.VarChar(5)
  fastingEnd   String @db.VarChar(5)

  /// When the mosque serves or recommends the pre-dawn meal.
  suhoorTime   String? @db.VarChar(5)
  /// When the fast is broken at the mosque.
  iftarTime    String? @db.VarChar(5)
  /// When Taraweeh begins. Null on the nights a mosque does not hold it.
  taraweehTime String? @db.VarChar(5)

  notes String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // One row per mosque per day. Entering the 14th twice is a mistake, not a second schedule — unlike
  // Jumu'ah, where a second jamaat on one Friday is ordinary. This also serves every read the table
  // has, since "one mosque's Ramadan 1447 in date order" is a prefix of it; no separate index.
  @@unique([mosqueId, year, date])
  @@map("ramadan_schedules")
}

// ---------------------------------------------------------------------------
// Giving: where money may be directed
//
// These two tables hold no money. A fund is the standing purpose a donation can be allocated to, a
// campaign is a time-boxed appeal within one; both are categories. The donations that reference them
// are in the section below, and neither table carries a copy of what has come in — no column here is
// written when a donation is recorded, and nothing here sums anything.
//
// `targetAmount` is `Decimal(14, 2)` for the reason at the top of this file. It is a goal rather than
// a balance, but it is displayed next to real totals on a progress bar, and a goal that arrives as
// 49999.999999999996 is worse than no goal.
// ---------------------------------------------------------------------------

enum FundStatus {
  active
  inactive
  completed
  archived
}

enum CampaignStatus {
  draft
  active
  completed
  cancelled
  archived
}

/// A purpose donations can be directed to: Zakat, Sadaqah, mosque maintenance, the imam's salary.
///
/// The set is per mosque and entirely the mosque's own — no seeded list, no enum of categories. Two
/// mosques that both keep a "General Fund" keep two rows, because the money is not shared.
model DonationFund {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  name String @db.VarChar(160)
  /// URL-safe identifier, unique within the mosque. Stable once issued: a public page may link to it.
  slug String @db.VarChar(64)

  description String? @db.Text

  status FundStatus @default(active)

  /// What the mosque hopes to raise, when it has said. Null means the fund runs open-ended, which is
  /// normal for Zakat and for a general fund.
  targetAmount Decimal? @db.Decimal(14, 2)

  /// The window the fund is collected over, when it has one. Both null for a standing fund.
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  /// Whether the public website may show this fund. False keeps it to the back office.
  isPublic Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  campaigns Campaign[]
  donations Donation[]

  // One slug per mosque, not one globally: the slug appears in a public URL, and two mosques are
  // each entitled to a "zakat".
  @@unique([mosqueId, slug])
  // Serves the list route, which filters by status far more often than it does not.
  @@index([mosqueId, status])
  @@index([mosqueId, createdAt])
  @@map("donation_funds")
}

/// A specific appeal: "Build the new roof", "Ramadan iftar 1447".
///
/// A campaign may sit inside a fund, so the roof appeal's money lands in the construction fund and is
/// accounted for there. `fundId` is nullable because a one-off appeal that belongs to no standing
/// fund is ordinary, and requiring a fund first would push mosques into creating throwaway ones.
model Campaign {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// The fund this appeal collects into, when it collects into one.
  ///
  /// `Restrict`, not `Cascade` or `SetNull`: deleting a fund must not silently take its campaigns with
  /// it, nor quietly orphan them. The service refuses the delete and offers archiving instead — this
  /// is the database saying the same thing to anything that bypasses the service.
  fundId String?       @db.Uuid
  fund   DonationFund? @relation(fields: [fundId], references: [id], onDelete: Restrict)

  title String @db.VarChar(200)
  /// URL-safe identifier, unique within the mosque.
  slug  String @db.VarChar(64)

  description String? @db.Text

  /// What the appeal is asking for. Required, unlike a fund's: an appeal without a number is a fund.
  targetAmount Decimal @db.Decimal(14, 2)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  status CampaignStatus @default(draft)

  /// A URL or storage key. Never the image itself — Postgres is not a CDN, and a 2 MB banner in a row
  /// is read back on every list query that forgets to exclude it.
  imageUrl String? @db.VarChar(500)

  /// Whether the public website may show this campaign. Independent of `status`: a completed appeal
  /// is often left visible with its result, and a drafted one is never visible.
  isPublic Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  donations Donation[]

  @@unique([mosqueId, slug])
  @@index([mosqueId, status])
  @@index([mosqueId, createdAt])
  @@index([fundId])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Money that moved
//
// The two tables above are categories; these two are events. A donation is money the mosque received,
// an expense is money it paid out, and each row is a record of something that happened rather than a
// plan for something that might.
//
// `amount` is `Decimal(14, 2)` on both, for the reason at the top of this file: these are the figures a
// treasurer reconciles against a bank statement, and a binary float cannot hold 0.10.
//
// Neither table is a ledger. There is no running balance, no `total`, no double entry, and nothing here
// is updated when a row is written — a fund does not carry what it has received, and a campaign does not
// carry what it has raised. Those totals are derived when reports arrive in a later part, from these rows,
// which are the only place the figures live.
//
// `currency` is stored per row rather than read from the mosque's settings at display time. A mosque that
// changes its default currency must not silently restate what a donor gave three years ago.
// ---------------------------------------------------------------------------

/// How money changed hands. Shared by donations and expenses, because "paid in cash" and "paid out in
/// cash" are the same fact about the transaction from either side.
///
/// `online` and `card` are recorded, not processed: nothing in this application talks to a payment
/// gateway. A row marked `online` is somebody writing down what a gateway elsewhere already did.
enum PaymentMethod {
  cash
  bank_transfer
  card
  online
  other
}

enum DonationStatus {
  /// Promised, or entered but not yet confirmed against the bank.
  pending
  /// The money is in. Only this state should be counted as received.
  completed
  /// The transfer or card was declined, or the pledge was never honoured.
  failed
  /// Withdrawn before it completed. Kept, rather than deleted, so the record of the attempt survives.
  cancelled
}

enum ExpenseStatus {
  pending
  approved
  paid
  /// The expense will not be paid. This is the reversible alternative to deleting a record that has
  /// been through any part of the process.
  cancelled
}

/// Money the mosque received, filed under the fund it was given to.
///
/// A donation may come from a registered user or from an anonymous donor, and the schema allows both
/// rather than inventing a placeholder account for the second. `userId` is null for a walk-in, a cash
/// box collection or a donor who asked not to be named; `donorName` and `donorEmail` are what a receipt
/// can be addressed to when there is no account behind it, and are also null for a genuinely anonymous
/// gift. A donation with neither a `userId` nor a `donorName` is ordinary — the Friday collection box is
/// exactly that.
model Donation {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// The donor, when the donor has an account.
  ///
  /// `Restrict` rather than `SetNull`: losing the link would turn an attributed donation into an
  /// anonymous one, which is a different fact. It never fires in practice — a user row is soft-deleted,
  /// as the comment on `User.deletedAt` says, precisely so references like this keep resolving.
  userId String? @db.Uuid
  donor  User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Which fund the money was given to. Required: money the mosque cannot say the purpose of is not
  /// something this table is willing to record.
  ///
  /// `Restrict` is what actually stops a fund with history from being deleted. `DonationFundsService`
  /// refuses first with a clearer message; this is the same refusal to anything that bypasses it.
  fundId String       @db.Uuid
  fund   DonationFund @relation(fields: [fundId], references: [id], onDelete: Restrict)

  /// The appeal this donation answered, when it answered one. Null for a gift straight to a fund.
  /// When both are set, the campaign must be one that collects into `fundId`; the service enforces
  /// that, because a foreign key cannot express agreement between two columns.
  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  /// Who to make the receipt out to, when there is no account to read it from.
  donorName  String? @db.VarChar(160)
  donorEmail String? @db.VarChar(160)

  amount   Decimal @db.Decimal(14, 2)
  /// ISO 4217, held per row. Defaults from the mosque's settings when the caller does not say, but is
  /// stored rather than referenced — see the section comment.
  currency String  @db.VarChar(8)

  paymentMethod PaymentMethod
  status        DonationStatus @default(pending)

  /// When the money was given, which is not when the row was written: a cash collection entered on
  /// Monday was given on Friday. A timestamp rather than a date, because a bank transfer's time of day
  /// is what reconciles it against a statement line.
  donatedAt DateTime @default(now()) @db.Timestamptz

  /// The mosque's own handle on the transaction: a bank reference, a receipt book number, a gateway id.
  /// Not unique — two mosques keep their own numbering, and a cash donation often has none at all.
  reference String? @db.VarChar(120)
  notes     String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Every index leads with `mosqueId`, because every query does: no read of this table is ever
  // unscoped, so an index that does not start there cannot serve one.
  @@index([mosqueId, status])
  @@index([mosqueId, donatedAt])
  @@index([mosqueId, createdAt])
  // Serves a member reading their own giving history, which is the one read a non-administrator makes.
  @@index([mosqueId, userId])
  @@index([mosqueId, fundId])
  @@index([mosqueId, campaignId])
  @@index([mosqueId, paymentMethod])
  @@map("donations")
}

/// Money the mosque paid out: a utility bill, a repair, an imam's honorarium, sacks of rice for iftar.
///
/// `category` is free text, per mosque, for the same reason fund names are: the way one mosque splits
/// "Utilities" from "Maintenance" is not the way the next one does, and an enum here would be a
/// permanent argument about whose chart of accounts is the real one.
model Expense {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  category    String @db.VarChar(120)
  description String @db.VarChar(500)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @db.VarChar(8)

  paymentMethod PaymentMethod

  /// The day the money was spent, as a calendar date. Unlike a donation, an expense is booked to a day
  /// — an electricity bill has no time of day — and a date column cannot pick up a timezone.
  expenseDate DateTime @db.Date

  /// Invoice number, cheque number, voucher reference. Not unique, for the same reason as a donation's.
  reference String? @db.VarChar(120)
  notes     String? @db.Text

  /// Who entered it. Required, and `Restrict`, so an expense always says who is answerable for it.
  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  status ExpenseStatus @default(pending)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([mosqueId, status])
  @@index([mosqueId, expenseDate])
  @@index([mosqueId, createdAt])
  @@index([mosqueId, category])
  @@index([mosqueId, createdById])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Money that is planned, and money owed to people
//
// A budget is an intention; a salary record is an obligation. Neither is a transaction, and neither is
// wired to one: booking an expense against a category does not draw down a budget with the same name, and
// marking a salary `paid` does not write an expense. Nothing in this schema moves a figure from one table
// to another, because the moment it did, the two would be able to disagree.
//
// `amount` is `Decimal(14, 2)` on both, as everywhere else money appears.
//
// There is no payroll here. No tax, no deduction, no allowance, no net-versus-gross: `amount` is the one
// figure the mosque agreed to pay, and a system that computed a second one would be claiming an authority
// over someone's pay that this application does not have.
// ---------------------------------------------------------------------------

enum BudgetStatus {
  /// Being drawn up. Not yet the figure anyone is working to.
  draft
  /// In force for its period. This is the only state a remaining-budget figure means anything in.
  active
  /// The period is over and the line is settled.
  closed
  /// Abandoned. Kept, rather than deleted, so the record of what was once planned survives.
  cancelled
}

enum SalaryStatus {
  /// Owed, not yet paid.
  pending
  /// Paid. Only this state should be counted as money that left.
  paid
  /// Will not be paid. The reversible alternative to deleting a record someone may have seen.
  cancelled
}

/// What a mosque intends to spend on something over a period.
///
/// `category` is free text, matching `Expense.category`, and the match is by convention rather than by
/// constraint: a report can total expenses whose category equals a budget's, but nothing forces an expense
/// to name a budget that exists, and creating a budget does not restrict what may be spent. A foreign key
/// here would mean every expense had to wait for a budget line, which is not how a mosque works.
///
/// `periodStart` and `periodEnd` are calendar dates, not instants. A budget covers days.
///
/// Overlapping budgets are permitted. A mosque may hold a draft alongside the active line it is meant to
/// replace, and may budget the same category over both a month and the year containing it. Deciding which
/// of those overlaps is a mistake is a judgement, and the database is not where judgements belong.
model Budget {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// What this line is called on the paper it came from, e.g. "Q3 Utilities".
  name     String @db.VarChar(160)
  /// The spending category this budget governs. Compared against `Expense.category`.
  category String @db.VarChar(120)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @db.VarChar(8)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  status BudgetStatus @default(draft)

  notes String? @db.Text

  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Every index leads with `mosqueId`, for the reason given on the donation indexes: no read of this table
  // is ever unscoped, so an index that does not start there cannot serve one.
  @@index([mosqueId, status])
  @@index([mosqueId, category])
  @@index([mosqueId, periodStart])
  @@index([mosqueId, createdAt])
  @@index([mosqueId, createdById])
  @@map("budgets")
}

/// One period's pay for one person.
///
/// The person is an ordinary `User`. There is no imam table and no staff table: whether someone is paid is
/// a fact about rows here, not a fact about which table their name sits in, and a second account for the
/// same human being would be one more thing to keep in step.
///
/// `userId` is required and is not nullable — a payment with nobody to pay is not a salary record. It is
/// `Restrict` rather than `SetNull` for the reason `User.deletedAt` exists: pay history has to keep naming
/// the person it was paid to.
///
/// `paymentDate` is when the money is due or was handed over, a calendar date. `payPeriod` is the month the
/// pay is *for*, which is a different fact — August's salary is routinely paid in September.
model SalaryRecord {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// Who is paid. Always in the same mosque as the record; the service checks it, because a foreign key
  /// cannot express "and their `mosqueId` must equal mine".
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @db.VarChar(8)

  /// The month this pay is for, as `YYYY-MM`. A fixed shape rather than free text, so that "2026-08" and
  /// "August 2026" cannot both exist and be counted as two periods.
  payPeriod String @db.VarChar(7)

  paymentDate DateTime @db.Date

  status SalaryStatus @default(pending)

  notes String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([mosqueId, status])
  @@index([mosqueId, userId])
  @@index([mosqueId, payPeriod])
  @@index([mosqueId, paymentDate])
  @@index([mosqueId, createdAt])
  @@map("salary_records")
}

// ---------------------------------------------------------------------------
// Audit
//
// Append-only by convention: rows are written and read, never updated. Financial and permission
// changes are the ones that matter, so the actor is recorded by id *and* by name — the name is
// denormalised so a log entry still reads correctly after the person's record changes.
// ---------------------------------------------------------------------------

model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// Null for actions taken before sign-in, e.g. a failed login attempt.
  actorId   String? @db.Uuid
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String  @db.VarChar(160)
  actorRole String? @db.VarChar(32)

  /// What happened, e.g. `ROLE_ASSIGNED`. One of the closed set in `src/audit/types/audit-log.types.ts`,
  /// so a writer cannot invent one and a search cannot miss one. Free text at the database level only
  /// because the constraint belongs in code, where the writers are.
  action String @db.VarChar(64)
  /// What kind of thing it happened to, e.g. `user`. The API calls this `entity`.
  resource String @db.VarChar(64)
  /// Id of the affected row, when the action concerns one.
  resourceId String? @db.VarChar(64)

  /// What changed. Never contains a password, token or secret — the writer passes field names and
  /// business values only, and `redactSecrets` strips anything whose name suggests otherwise.
  changes Json?
  /// Free-text note, e.g. the reason given when voiding a donation.
  note    String? @db.Text

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([mosqueId, createdAt])
  @@index([mosqueId, resource, resourceId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Approvals
//
// A four-state review record, not a workflow engine. There are no stages, no routing rules, no
// parallel reviewers and no state machine beyond the one the enum describes: something is proposed,
// and then somebody with authority accepts or declines it.
//
// The generic `entity`/`entityId` pair is what makes it reusable across expenses, salary, donations
// and whatever comes later without this table knowing any of their schemas. That is deliberately not
// a set of nullable foreign keys — a column per reviewable table would grow with every module and
// leave every row mostly null. The cost is that the reference is unenforced, so nothing stops a row
// pointing at an id that has since been deleted; a reviewer sees the reference, not a join.
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

/// One request for review.
///
/// `status` starts `pending` and moves exactly once. There is no path back to `pending`: a decision is
/// a record of what somebody decided, and re-opening it would erase that. A second look means a second
/// request, which is why nothing here forbids two rows over the same target.
model ApprovalRequest {
  id       String @id @default(uuid()) @db.Uuid
  mosqueId String @db.Uuid
  mosque   Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  /// Who asked. Not nullable — an unattributed request cannot be reviewed, because the first question
  /// a reviewer has is who wants this. `Restrict` rather than `SetNull` for the same reason; users are
  /// soft-deleted here anyway, so the row keeps resolving.
  requestedById String @db.Uuid
  requestedBy   User   @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  /// What kind of thing needs review — `expense`, `salary`, `donation`. Matches the first half of a
  /// permission, like `AuditLog.resource`, and is validated in code against a closed list rather than
  /// by the database, so adding a reviewable kind is a reviewable code change.
  entity   String @db.VarChar(64)
  /// The row under review. Unenforced by design; see the section note.
  entityId String @db.VarChar(64)
  /// What is proposed — `create`, `update`, `delete`, `pay`, `void`. Also a closed list in code.
  action   String @db.VarChar(64)

  status ApprovalStatus @default(pending)

  /// Why it is being asked for, in the requester's words. Optional: an expense over the threshold
  /// often needs no explanation beyond the expense itself.
  reason String? @db.Text

  /// Null while pending. Set together with `reviewedAt` and the terminal status, in one update.
  reviewedById String? @db.Uuid
  reviewedBy   User?   @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @db.Timestamptz
  /// The reviewer's note. The one field a rejection should always carry, though it is not forced —
  /// requiring it would produce a table full of "no".
  comment      String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  /// One mosque's queue, pending first, newest first — the read this table exists for.
  @@index([mosqueId, status, createdAt])
  /// Serves "is there anything outstanding against this row", which is the question a module asks
  /// before letting an operation through, and which the service also uses to refuse a second pending
  /// request for the same target. That rule is enforced in the service rather than by a partial unique
  /// index: Prisma cannot express `WHERE status = 'pending'`, so hand-writing one into the migration
  /// would leave the database permanently drifted from this file and every later `migrate dev` asking
  /// to reset it. A duplicate created by two simultaneous requests is a duplicate row in a review
  /// queue, which a reviewer resolves; a reset is data loss.
  @@index([entity, entityId, status])
  @@index([requestedById])
  @@map("approval_requests")
}
